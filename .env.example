# Copy to .env.local (never commit .env.local) and fill in from Supabase → Project Settings → API.
# Leave both empty to run Seek in demo mode (no sign-in, sample data in the browser).

# Public: safe in the browser. Row-level security (supabase/migrations) decides what each person can see.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional, demo mode only (no Supabase above): makes "Continue with Google" a real Google sign-in in the browser.
# With Supabase configured, Google sign-in goes through Supabase (Authentication → Providers → Google) instead.
# Also add it in Vercel → Project → Settings → Environment Variables. It is public; there is no client secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
