# Copy to .env.local (never commit .env.local) and fill in from Supabase → Project Settings → API.
# Leave both empty to run Seek in demo mode (no sign-in, sample data in the browser).

# Public: safe in the browser. Row-level security (supabase/migrations) decides what each person can see.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
